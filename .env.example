# =============================================================================
# MASTER PROJECT ENVIRONMENT CONFIGURATION
# Copy this file to .env.local for each client/architect deployment.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. CORE APPLICATION & ADMIN SECURITY
# -----------------------------------------------------------------------------
APP_URL=http://localhost:3000
ADMIN_PASSWORD=your_secure_admin_password_here

# Set to "false" in real client production deployments.
# When set to "true", mock data, fake payments, and calendar fallbacks are enabled.
NEXT_PUBLIC_DEMO_MODE=false

# -----------------------------------------------------------------------------
# 2. SUPABASE DATABASE & STORAGE
# Create a free project at https://supabase.com for each architect.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key_here

# -----------------------------------------------------------------------------
# 3. RAZORPAY PAYMENT GATEWAY
# Get API Keys from https://dashboard.razorpay.com/#/app/keys
# Enables direct consultation booking and e-book payments to the architect's bank.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxxxxxx
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here

# -----------------------------------------------------------------------------
# 4. GOOGLE CALENDAR INTEGRATION (SERVICE ACCOUNT)
# Enables consultation bookings to sync automatically to the architect's Google Calendar.
# -----------------------------------------------------------------------------
# Google Cloud Service Account Email (e.g. platform-sync@project.iam.gserviceaccount.com)
GOOGLE_CALENDAR_CLIENT_EMAIL=your-service-account@your-gcp-project.iam.gserviceaccount.com

# Private key with newlines formatted as \n
GOOGLE_CALENDAR_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# The Architect's Google Calendar ID (e.g. architect@gmail.com or c_xxx@group.calendar.google.com)
# The architect must share their calendar with GOOGLE_CALENDAR_CLIENT_EMAIL with "Make changes to events" permission.
GOOGLE_CALENDAR_ID=architect.email@gmail.com

# -----------------------------------------------------------------------------
# 5. LEAD EMAIL NOTIFICATIONS (GMAIL SMTP)
# Instant email notification sent when a new consultation or service lead is received.
# Generate an App Password at: https://myaccount.google.com/apppasswords
# -----------------------------------------------------------------------------
GMAIL_USER=your.studio.notifications@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
